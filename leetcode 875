class Solution:
    def minEatingSpeed(self, piles, h):
        left, right = 1, max(piles)
        
        while left <= right:
            mid = (left + right) // 2
            
            hours = 0
            for pile in piles:
                # Avoid float ceil → use integer math
                hours += (pile + mid - 1) // mid
            
            if hours > h:
                left = mid + 1
            else:
                right = mid - 1
        
        return left
