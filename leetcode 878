class Solution:
    def nthMagicalNumber(self, n, a, b):
        MOD = 10**9 + 7
        
        # Helper to find gcd
        def gcd(x, y):
            while y:
                x, y = y, x % y
            return x
        
        # LCM
        lcm = (a * b) // gcd(a, b)
        
        left, right = 1, n * min(a, b)
        
        while left < right:
            mid = (left + right) // 2
            
            count = (mid // a) + (mid // b) - (mid // lcm)
            
            if count < n:
                left = mid + 1
            else:
                right = mid
        
        return left % MOD
