class Solution:
    def profitableSchemes(self, n, minProfit, group, profit):
        MOD = 10**9 + 7
        
        # dp[m][p] = number of ways
        dp = [[0] * (minProfit + 1) for _ in range(n + 1)]
        
        # Base case: 0 profit, 0 members → 1 way
        dp[0][0] = 1
        
        for g, p in zip(group, profit):
            # Traverse backwards (important for 0/1 knapsack)
            for members in range(n, g - 1, -1):
                for prof in range(minProfit, -1, -1):
                    new_profit = min(minProfit, prof + p)
                    dp[members][new_profit] += dp[members - g][prof]
                    dp[members][new_profit] %= MOD
        
        # Sum all ways with profit ≥ minProfit
        return sum(dp[m][minProfit] for m in range(n + 1)) % MOD
