class Solution:
    def maxSumDivThree(self, nums):
        dp = [0, -10**9, -10**9]  # only integers
        
        for num in nums:
            temp = dp[:]  # snapshot
            
            for i in range(3):
                new_sum = temp[i] + num
                dp[new_sum % 3] = max(dp[new_sum % 3], new_sum)
        
        return dp[0]
